# Environment variables (example — no secrets here)
#
# Copy to .env only for local runs outside the trial harness. The trial
# sandbox sets these itself. Never put a real API key in this file or in
# the repository: keys come from the trial brief, or from the environment
# of the machine that runs the server.

# Base URL of the trial env (providers live under it, e.g. /p/groq).
MAKEFUN_ENV_URL=http://127.0.0.1:18101

# Path to the brief: provider directory, quality table, workload manifest.
MAKEFUN_PROMPT_FILE=/path/to/prompt.txt

# Seed for any randomness the server needs (it needs none).
MAKEFUN_TRIAL_SEED=
